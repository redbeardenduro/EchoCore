# --- Python ---
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
wheels/
pip-wheel-metadata/
*.manifest
*.spec

# PyInstaller
# Usually these files are written by a python script from a template
# before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.log
.pytest_cache/
.tox/

# --- Project EchoCore Specific ---
# Virtual Environment (match name used in install.sh/setup)
venv/
.venv/
env/
ENV/

# API Keys and Sensitive Configuration
.env
*.env

# User Configuration (users typically don't commit their specific settings)
user_config.json

# Logs Directory and Install Logs
logs/
echocore_install_*.log
# Optionally ignore specific log files if not ignoring the whole directory
# *.log

# Cache Directory
cache/

# Downloaded Models (these are usually large and downloaded separately)
# Ignore the entire models directory, assuming model_downloader places everything here.
# If the directory structure itself should be tracked, ignore specific subdirs/files instead.
models/
# Alternatively, ignore only specific large file types within models:
# models/**/*.onnx
# models/**/*.onnx.json
# models/**/*.zip
# models/**/*.tar.gz
# models/**/*.tgz
# models/**/*.pbmm
# models/**/*.pv
# models/**/*.ppn

# Temporary Download Files
*.part

# Generated Audio Files (e.g., from tests)
*.wav
*.mp3
*.raw
# Be more specific if needed:
# piper_test_output.wav
# test_output.wav

# --- IDE / Editor Files ---
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.komodoproject
*~
*.swp
*.swo

# --- OS generated files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- Other ---
# Add any other files or directories specific to your development workflow below
