{
  "#": "Project EchoCore User Configuration Example",
  "#": "Add settings here to override defaults from config.py",
  "#": "Only include keys you want to change.",

  "LOG_LEVEL": "DEBUG",

  "# --- Audio Settings ---": "",
  "AUDIO_INPUT_DEVICE_INDEX": null,
  "AUDIO_OUTPUT_DEVICE_INDEX": null,
  "ENABLE_AUDIO_CUES": true,
  "AUDIO_CUE_VOLUME": 0.4,

  "# --- Wake Word (Porcupine) ---": "",
  "#": "Paths should be relative to the 'models' directory or absolute.",
  "PORCUPINE_KEYWORD_PATHS": [
    "porcupine/echo_raspberry-pi.ppn"
  ],
  "PORCUPINE_SENSITIVITIES": [0.6],
  "LISTENING_TIMEOUT": 12.0,

  "# --- STT (Vosk) ---": "",
  "STT_CONFIDENCE_THRESHOLD": 0.75,

  "# --- LLM (OpenAI) ---": "",
  "LLM_MODEL": "gpt-4o-mini",
  "LLM_TEMPERATURE": 0.65,
  "LLM_MAX_CONVERSATION_TURNS": 8,
  "LLM_SYSTEM_PROMPT": "You are Echo, an AI assistant. Keep responses brief and helpful.",

  "# --- TTS ---": "",
  "TTS_ENGINE": "piper", "# options: openai, elevenlabs, piper",
  "#": "Settings for OpenAI TTS (if TTS_ENGINE='openai')",
  "OPENAI_TTS_VOICE": "nova",
  "#": "Settings for ElevenLabs TTS (if TTS_ENGINE='elevenlabs')",
  "ELEVENLABS_VOICE": "Rachel",
  "#": "Settings for Piper TTS (if TTS_ENGINE='piper')",
  "PIPER_MODEL_PATH": "models/piper/en_GB-southern_english_male-medium.onnx", "# Example UK voice",

  "# --- Avatar ---": "",
  "AVATAR_WINDOW_WIDTH": 1024,
  "AVATAR_WINDOW_HEIGHT": 600,
  "AVATAR_ANIMATION_STYLE": "hologram", "# options: circle, wave, particle, hologram",
  "AVATAR_FPS": 25,
  "AVATAR_FULLSCREEN": false,
  "AVATAR_DEBUG_OVERLAY": false,
  "AVATAR_DISPLAY_STATUS_TEXT": true,

  "# --- Web Interface ---": "",
  "WEB_INTERFACE_ENABLED": true,
  "WEB_INTERFACE_PORT": 8080,
  "WEB_INTERFACE_HOST": "0.0.0.0",
  "WEB_INTERFACE_USERNAME": "admin",
  "WEB_INTERFACE_PASSWORD": "your_secure_password"

}
